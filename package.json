{
  "name": "veritas",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@contentauth/c2pa-node": "^0.10.1",
    "@contentauth/c2pa-web": "^0.16.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "engine:build": "node scripts/build-engine.mjs && node scripts/build-engine.mjs --test",
    "fixtures": "node scripts/make-fixtures.mjs && node scripts/capture-reports.cjs",
    "test:engine": "node e2e/engine.e2e.cjs",
    "postinstall": "node scripts/build-engine.mjs && node scripts/build-engine.mjs --test",
    "test:journey": "expo export -p web --output-dir dist && node e2e/journey.e2e.cjs",
    "screenshots": "node e2e/screenshots.cjs 2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
